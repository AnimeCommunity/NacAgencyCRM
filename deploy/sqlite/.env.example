DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-jwt-secret
DJANGO_ALLOWED_HOSTS=your-backend-host.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend-host.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-host.example.com

DB_ENGINE=sqlite
SQLITE_NAME=/var/data/nacagencycrm/db.sqlite3
SQLITE_TIMEOUT=30

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
CRM_SMTP_PASSWORD=
CRM_SMTP_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
CRM_SMTP_ALLOWED_HOSTS=smtp.gmail.com,smtp.office365.com,smtp.mail.yahoo.com
