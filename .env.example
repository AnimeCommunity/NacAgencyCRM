# Copy this file to .env and replace every placeholder before deployment.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-jwt-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

DB_ENGINE=postgresql
POSTGRES_DB=crm_anc
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
CRM_SMTP_PASSWORD=
CRM_SMTP_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-for-this-deployment
CRM_SMTP_ALLOWED_HOSTS=smtp.gmail.com,smtp.office365.com,smtp.mail.yahoo.com

NEXT_PUBLIC_API_URL=https://api.example.com/api
